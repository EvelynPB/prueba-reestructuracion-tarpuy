# Copia este archivo como .env y completa los valores (el .env no se sube a GitHub).
# Con docker compose (PostgreSQL local), cada sistema usa su rol con permisos mínimos:
DATABASE_URL_LECTOR=postgresql://resultados_lector:lector_local@localhost:5432/concurso
DATABASE_URL_ADMIN=postgresql://resultados_admin:admin_local@localhost:5432/concurso
ADMIN_PASSWORD=cambia-esta-clave
PORT=3000
